{
  "version": 2,
  "functions": {
    "backend/*.py": { "runtime": "@vercel/python@3.10" }
  },
  "routes": [
    { "src": "/api/user", "dest": "backend/user_create.py" },
    { "src": "/api/session", "dest": "backend/session_create.py" },
    { "src": "/api/chatload", "dest": "backend/chatload.py" },
    { "src": "/api/check-profile-access", "dest": "backend/check_profile_access.py" },
    { "src": "/api/conversation/new", "dest": "backend/conversation_new.py" },
    { "src": "/api/entries", "dest": "backend/entries.py" },
    { "src": "/api/profile/generate", "dest": "backend/generate_personal_profile.py" },
    { "src": "/api/has-history", "dest": "backend/has_history.py" },
    { "src": "/api/last-session", "dest": "backend/last_session.py" },
    { "src": "/api/profile/from-survey", "dest": "backend/profile_from_survey.py" },
    { "src": "/api/profile", "dest": "backend/profile_handler.py" },
    { "src": "/api/profile-list", "dest": "backend/profile_list.py" },
    { "src": "/api/respond", "dest": "backend/respond.py" },
    { "src": "/api/session/close", "dest": "backend/session_close.py" },
    { "src": "/api/session/update-label", "dest": "backend/session_update_label.py" },
    { "src": "/api/memory/summary", "dest": "backend/memory_summary.py" }
  ]
}